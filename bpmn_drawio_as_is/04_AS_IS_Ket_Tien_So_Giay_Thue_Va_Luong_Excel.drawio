  <diagram id="diag_as_is_04" name="04_AS_IS_Ket_Tien_So_Giay_Thue_Va_Luong_Excel">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4000" pageHeight="1720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="banner_2" value="&lt;b style='font-size:15px;'&gt;SƠ ĐỒ AS-IS 04 — QUY TRÌNH ĐẾM KÉT SỔ TAY, HẸN XUẤT HÓA ĐƠN VAT &amp; TÍNH LƯƠNG / LÃI LỖ EXCEL TRƯỚC KHI LÊN HỆ THỐNG (1 POOL DUY NHẤT)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11.5px;color:#222222;'&gt;Làm rõ bất cập trước khi lên hệ thống: Không tách tự động thuế GTGT 8% (đồ ăn) &amp; 10% (bia rượu) | Đếm két tiền mặt lệch do quên ghi phiếu chi vặt | Nhập lại bill giấy vào Excel mất nhiều ngày&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="12" width="3900" height="52"/>
        </mxCell>
        <mxCell id="legend_3" value="&lt;b&gt;CHÚ GIẢI KÝ HIỆU BPMN 2.0 NÂNG CAO TRÊN SƠ ĐỒ:&lt;/b&gt; &amp;nbsp;&amp;nbsp;[Timer] &lt;b&gt;Timer Event&lt;/b&gt; (Đếm giờ / Định kỳ / Quá hạn) &amp;nbsp;|&amp;nbsp; [Link] &lt;b&gt;Link Event [Throw/Catch]&lt;/b&gt; (Nối chuyển tiếp gọn sơ đồ) &amp;nbsp;|&amp;nbsp; [Signal] &lt;b&gt;Signal Event&lt;/b&gt; (Phát/Nhận tín hiệu đồng bộ toàn hệ thống) &amp;nbsp;|&amp;nbsp; [Escalation] &lt;b&gt;Escalation Event&lt;/b&gt; (Leo thang từ Quản lý ca lên Chủ quán) &amp;nbsp;|&amp;nbsp; [Error] &lt;b&gt;Error Event&lt;/b&gt; (Bắt lỗi nghiệp vụ) &amp;nbsp;|&amp;nbsp; [Compensation] &lt;b&gt;Compensation&lt;/b&gt; (Bồi hoàn tồn bể cá / kho bia / KM) &amp;nbsp;|&amp;nbsp; [Conditional] &lt;b&gt;Conditional&lt;/b&gt; (Điều kiện tự động) &amp;nbsp;|&amp;nbsp; [Terminate] &lt;b&gt;Terminate End&lt;/b&gt; / [Cancel] &lt;b&gt;Cancel End&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="70" width="3900" height="34"/>
        </mxCell>
        <mxCell id="pool_4" value="POOL DUY NHẤT: QUY TRÌNH ĐẾM KÉT TIỀN MẶT, XUẤT HÓA ĐƠN VAT &amp; TỔNG HỢP LƯƠNG / P&amp;L THỦ CÔNG (AS-IS MANUAL ACCOUNTING)" style="swimlane;html=1;horizontal=0;startSize=38;whiteSpace=wrap;fillColor=#fbe9e7;strokeColor=#bf360c;strokeWidth=2.2;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="112" width="3900" height="1560"/>
        </mxCell>
        <mxCell id="lane_5" value="1. Khách Hàng Công Ty (Ghi giấy MST chờ gửi HĐĐT sau)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="0" width="3862" height="250"/>
        </mxCell>
        <mxCell id="lane_6" value="2. Thu Ngân / Quản Lý (Đếm tiền mặt ghi sổ / Quên chi vặt)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#f3e5f5;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="250" width="3862" height="380"/>
        </mxCell>
        <mxCell id="lane_7" value="3. Chủ Quán &amp; Kế Toán (Gõ lại bill vào Excel tính Thuế/Lương)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#ffebee;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="630" width="3862" height="450"/>
        </mxCell>
        <mxCell id="lane_8" value="4. Sổ Sách Giấy &amp; File Excel Rời Rạc (Dễ sai công thức)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#efebe9;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="1080" width="3862" height="480"/>
        </mxCell>
        <mxCell id="evt_9" value="Cuối đêm đếm két
[Start]" style="shape=mxgraph.bpmn.shape;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="lane_6">
          <mxGeometry as="geometry" x="55" y="105" width="40" height="40"/>
        </mxCell>
        <mxCell id="task_10" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Manual Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Khách công ty yêu cầu xuất Hóa đơn GTGT -&gt; Phải ghi Mã số thuế &amp; Email ra mảnh giấy kẹp vào bill (Không lấy và tra cứu ngay được)&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=manual;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_5">
          <mxGeometry as="geometry" x="145" y="80" width="245" height="74"/>
        </mxCell>
        <mxCell id="task_11" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Manual Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Thu ngân đếm cục tiền mặt trong ngăn kéo cuối đêm (Không có bảng kiểm theo từng mệnh giá &amp; quên ghi các khoản rút két mua đá/gas/ứng lương)&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=manual;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_6">
          <mxGeometry as="geometry" x="450" y="90" width="250" height="76"/>
        </mxCell>
        <mxCell id="evt_12" value="Lệch tiền két không rõ lý do!
[Error Boundary]" style="shape=mxgraph.bpmn.shape;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;outline=boundInt;symbol=error;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="lane_6">
          <mxGeometry as="geometry" x="635" y="148" width="34" height="34"/>
        </mxCell>
        <mxCell id="pain_13" value="&lt;b style='font-size:9px;color:#b71c1c;'&gt;[ĐIỂM NGHẼN / RỦI RO AS-IS] Tranh cãi lệch két cuối đêm&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#333333;'&gt;Không tách bạch thu tiền mặt, chi tiền vặt, chi ứng lương và chi trả Tip; sau khi đóng ca vẫn có thể sửa lại tờ bill giấy&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=middle;align=center;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;dashed=1;fontSize=9.5;" vertex="1" parent="lane_6">
          <mxGeometry as="geometry" x="450" y="210" width="250" height="64"/>
        </mxCell>
        <mxCell id="evt_14" value="LINK EXCEL
(Gõ lại bảng tính thuế)" style="shape=mxgraph.bpmn.shape;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;outline=catching;symbol=link;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;" vertex="1" parent="lane_7">
          <mxGeometry as="geometry" x="745" y="15" width="40" height="40"/>
        </mxCell>
        <mxCell id="gw_15" value="Vào nhập Excel" style="shape=mxgraph.bpmn.shape;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="lane_7">
          <mxGeometry as="geometry" x="743" y="111" width="44" height="44"/>
        </mxCell>
        <mxCell id="task_16" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Manual Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Hôm sau Kế toán/Chủ quán ngồi gõ lại từng tờ bill giấy vào File Excel để tách món ăn (VAT 8%) và bia rượu (VAT 10%) xuất HĐĐT&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=manual;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_7">
          <mxGeometry as="geometry" x="815" y="95" width="255" height="76"/>
        </mxCell>
        <mxCell id="evt_17" value="Nhầm thuế suất 8% và 10%!
[Error Boundary]" style="shape=mxgraph.bpmn.shape;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;outline=boundInt;symbol=error;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="lane_7">
