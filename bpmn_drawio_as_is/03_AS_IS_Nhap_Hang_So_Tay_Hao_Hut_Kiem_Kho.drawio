        </mxCell>
        <mxCell id="task_21" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Manual Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Thu ngân nhận tờ giấy đếm kho nhưng không kịp cộng lượng Bán từ hàng trăm tờ bill giấy và lượng Hỏng trong ca&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=manual;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_8">
          <mxGeometry as="geometry" x="1770" y="90" width="245" height="76"/>
        </mxCell>
        <mxCell id="pain_22" value="&lt;b style='font-size:9px;color:#b71c1c;'&gt;[ĐIỂM NGHẼN / RỦI RO AS-IS] Thiếu Đối soát 4 lớp tự động&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#333333;'&gt;Không tính được [Đầu ca + Nhập - Bán theo BOM - Hỏng = Lý thuyết] ngay lúc đóng ca -&gt; Thất thoát 5-15% nguyên liệu mỗi tháng&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=middle;align=center;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;dashed=1;fontSize=9.5;" vertex="1" parent="lane_8">
          <mxGeometry as="geometry" x="1770" y="200" width="245" height="64"/>
        </mxCell>
