        </mxCell>
        <mxCell id="pain_26" value="&lt;b style='font-size:9px;color:#b71c1c;'&gt;[ĐIỂM NGHẼN / RỦI RO AS-IS] Rủi ro Bill giả &amp; Tắc nghẽn khi Chủ quán vắng mặt&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#333333;'&gt;Nếu Chủ quán đang bận hoặc mất sóng ĐT, cả Phục vụ và Khách phải đứng đợi; dễ bị lừa bằng ảnh chụp màn hình chỉnh sửa&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=middle;align=center;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;dashed=1;fontSize=9.5;" vertex="1" parent="lane_8">
          <mxGeometry as="geometry" x="2045" y="210" width="250" height="64"/>
        </mxCell>
        <mxCell id="task_27" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Manual Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Khi khách chuyển khoản dư 50k-100k làm Tiền Tip cho Phục vụ: Thu ngân không biết hoặc không dám tự rút két trả vì sợ lệch sổ&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=manual;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_7">
          <mxGeometry as="geometry" x="2365" y="90" width="250" height="76"/>
        </mxCell>
        <mxCell id="pain_28" value="&lt;b style='font-size:9px;color:#b71c1c;'&gt;[ĐIỂM NGHẼN / RỦI RO AS-IS] Không phân bổ được Tiền Tip QR&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#333333;'&gt;Không tự động tách được tiền Tip trên mức bill để chia cho nhân viên quản bàn hay chia đều trong ca&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=middle;align=center;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;dashed=1;fontSize=9.5;" vertex="1" parent="lane_7">
          <mxGeometry as="geometry" x="2365" y="200" width="250" height="60"/>
        </mxCell>
        <mxCell id="task_29" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Manual Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Thu ngân cất tờ bill giấy vào ngăn kéo &amp; Báo miệng Phục vụ dọn bàn&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=manual;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_7">
          <mxGeometry as="geometry" x="2680" y="90" width="220" height="70"/>
        </mxCell>
