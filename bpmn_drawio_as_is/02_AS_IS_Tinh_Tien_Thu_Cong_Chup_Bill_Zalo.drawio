        </mxCell>
        <mxCell id="lane_8" value="4. Chủ Quán (Mở App Ngân hàng dò từng tin nhắn Zalo)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#ffebee;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="930" width="3962" height="340"/>
        </mxCell>
        <mxCell id="lane_9" value="5. Ngân Hàng Cá Nhân (QR tĩnh không mã định danh bàn)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#e0f2f1;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="1270" width="3962" height="370"/>
