        <mxCell id="task_28" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Script Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Engine.pnl: Tính Báo cáo Lãi Lỗ (Doanh thu thuần - Giá vốn BOM/Hải sản/Bia - Chi phí cố định - Hao hụt hỏng = Lãi ròng)&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=script;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_7">
