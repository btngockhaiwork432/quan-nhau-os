        <mxCell id="task_18" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[User Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Mở Modal 'Chốt ca Z-Report': Nhập số tờ thực đếm theo từng mệnh giá (500k, 200k, 100k, 50k, 20k, 10k, 5k, 2k, 1k)&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_6">
