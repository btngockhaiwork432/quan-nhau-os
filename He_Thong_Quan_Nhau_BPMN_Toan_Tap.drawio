  <diagram id="diag_04_tax_pnl" name="04_BPMN_In_Bill_HDDT_Thue_Va_Khoa_So_Odoo">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4050" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="banner_2" value="&lt;b style='font-size:15px;'&gt;SƠ ĐỒ 04 — QUY TRÌNH XUẤT HÓA ĐƠN ĐIỆN TỬ GTGT (8% &amp; 10%), CHỐT CA Z-REPORT, TÍNH BẢNG LƯƠNG &amp; BÁO CÁO LÃI LỖ P&amp;L (1 POOL DUY NHẤT)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11.5px;color:#222222;'&gt;Đồng nhất 100% với #/customer, #/cashier và #/owner: Tách thuế GTGT 8% (Đồ ăn) &amp; 10% (Bia rượu) | Kiểm tiền mặt theo mệnh giá &amp; Khóa sổ Z-Report | Tự động tính Lương (Cộng Tip QR, Hoa hồng PG) &amp; P&amp;L trên PostgreSQL 16&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="12" width="3950" height="52"/>
        </mxCell>
        <mxCell id="legend_3" value="&lt;b&gt;CHÚ GIẢI KÝ HIỆU BPMN 2.0 NÂNG CAO TRÊN SƠ ĐỒ:&lt;/b&gt; &amp;nbsp;&amp;nbsp;[Timer] &lt;b&gt;Timer Event&lt;/b&gt; (Đếm giờ / Định kỳ / Quá hạn) &amp;nbsp;|&amp;nbsp; [Link] &lt;b&gt;Link Event [Throw/Catch]&lt;/b&gt; (Nối chuyển tiếp gọn sơ đồ) &amp;nbsp;|&amp;nbsp; [Signal] &lt;b&gt;Signal Event&lt;/b&gt; (Phát/Nhận tín hiệu đồng bộ toàn hệ thống) &amp;nbsp;|&amp;nbsp; [Escalation] &lt;b&gt;Escalation Event&lt;/b&gt; (Leo thang từ Quản lý ca lên Chủ quán) &amp;nbsp;|&amp;nbsp; [Error] &lt;b&gt;Error Event&lt;/b&gt; (Bắt lỗi nghiệp vụ) &amp;nbsp;|&amp;nbsp; [Compensation] &lt;b&gt;Compensation&lt;/b&gt; (Bồi hoàn tồn bể cá / kho bia / KM) &amp;nbsp;|&amp;nbsp; [Conditional] &lt;b&gt;Conditional&lt;/b&gt; (Điều kiện tự động) &amp;nbsp;|&amp;nbsp; [Terminate] &lt;b&gt;Terminate End&lt;/b&gt; / [Cancel] &lt;b&gt;Cancel End&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="70" width="3950" height="34"/>
        </mxCell>
        <mxCell id="pool_4" value="POOL DUY NHẤT: QUY TRÌNH PHÁT HÀNH HĐĐT GTGT (8%/10%), KIỂM KÉT CHỐT CA Z-REPORT, TÍNH BẢNG LƯƠNG &amp; BÁO CÁO LÃI LỖ P&amp;L" style="swimlane;html=1;horizontal=0;startSize=38;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2.2;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="112" width="3950" height="1620"/>
        </mxCell>
        <mxCell id="lane_5" value="1. Khách Hàng (#/customer · Tra cứu HĐĐT GTGT)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="0" width="3912" height="250"/>
        </mxCell>
