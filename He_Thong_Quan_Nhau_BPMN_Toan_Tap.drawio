        <mxCell id="paper_12" value="&lt;b style='font-size:9px;color:#6d4c41;'&gt;[GIẤY TỜ / SỔ TAY THỦ CÔNG]&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;'&gt;Sổ Tay Nhập Hàng&lt;br/&gt;[Không có mã cá #CM-01, không tính BOM]&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=middle;align=center;fillColor=#efebe9;strokeColor=#6d4c41;strokeWidth=1.3;fontSize=9.5;" vertex="1" parent="lane_5">
          <mxGeometry as="geometry" x="155" y="180" width="215" height="52"/>
