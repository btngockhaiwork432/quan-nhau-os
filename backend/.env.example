# Cau hinh ket noi PostgreSQL cho Quan Nhau OS
# De DATABASE_URL=auto de he thong tu dong khoi chay PostgreSQL 16.2 tich hop (backend/pgdata)
# Hoac dien chuoi ket noi PostgreSQL ngoai / Docker:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/quan_nhau_os
DATABASE_URL=auto
POSTGRES_DB=quan_nhau_os
PORT=8765
