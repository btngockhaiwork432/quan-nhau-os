        <mxCell id="lane_9" value="5. Hệ Thống Hóa Đơn Điện Tử &amp; Lưu Trữ Sổ Sách" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#e0f2f1;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
