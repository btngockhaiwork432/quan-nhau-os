        <mxCell id="evt_10" value="Yêu cầu HĐĐT / Chốt ca
[Start]" style="shape=mxgraph.bpmn.shape;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="lane_6">
          <mxGeometry as="geometry" x="55" y="105" width="40" height="40"/>
        </mxCell>
        <mxCell id="task_11" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[User Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Nhập thông tin xuất Hóa đơn điện tử GTGT tại quầy (Tên đơn vị, Mã số thuế, Địa chỉ, Email) hoặc khách tự yêu cầu&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_6">
          <mxGeometry as="geometry" x="145" y="90" width="235" height="72"/>
        </mxCell>
        <mxCell id="task_12" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Business Rule]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Engine.requestEInvoice: Tự động tách doanh thu &amp; tiền thuế GTGT theo 2 nhóm: Đồ ăn (VAT 8%) và Bia rượu (VAT 10%)&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=businessRule;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_8">
          <mxGeometry as="geometry" x="145" y="90" width="245" height="74"/>
        </mxCell>
        <mxCell id="task_13" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[Service Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Cấp số Hóa đơn điện tử, Mã tra cứu (lookupCode) &amp; Lưu vào bảng einvoices trên PostgreSQL 16&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=service;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_9">
          <mxGeometry as="geometry" x="435" y="90" width="235" height="72"/>
        </mxCell>
        <mxCell id="task_14" value="&lt;span style='font-size:9.5px;color:#444444;'&gt;[User Task]&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:10.5px;'&gt;Khách hàng mở Tab 'Hóa đơn điện tử' (#/customer): Nhập Mã tra cứu / Mã bill xem chi tiết bảng tách thuế 8% &amp; 10%&lt;/b&gt;" style="shape=mxgraph.bpmn.task;html=1;whiteSpace=wrap;rectStyle=rounded;size=10;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="lane_5">
          <mxGeometry as="geometry" x="435" y="80" width="240" height="70"/>
        </mxCell>
