          <mxGeometry as="geometry" x="38" y="250" width="3912" height="380"/>
        </mxCell>
        <mxCell id="lane_7" value="3. Chủ Quán &amp; Kế Toán (#/owner · P&amp;L, Lương &amp; Thuế)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
          <mxGeometry as="geometry" x="38" y="630" width="3912" height="360"/>
        </mxCell>
        <mxCell id="lane_8" value="4. Engine Tự Động (FastAPI + PostgreSQL 16)" style="swimlane;html=1;horizontal=0;startSize=36;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool_4">
